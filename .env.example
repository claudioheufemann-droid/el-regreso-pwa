# Supabase (compartido por ambos módulos)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Módulo Gestión — Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@elregresobeer.com

# Módulo Gestión — Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@elregresobeer.com

# Cron auth
CRON_SECRET=

# Módulo Deudores — Scheduled Uploads (2x daily)
DEUDORES_CRON_SECRET=your-secret-token-for-cron-uploads
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Módulo Logística — WhatsApp Business Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Nombre de la plantilla aprobada en Meta Business Manager para confirmar entrega al cliente
# fuera de la ventana de 24h. Mientras no exista, se usa un mensaje libre (solo funciona si el
# cliente escribió antes en las últimas 24h).
WHATSAPP_TEMPLATE_ENTREGA_CONFIRMADA=
# Debe coincidir EXACTAMENTE con el secreto embebido en el trigger fn_notificar_entrega
# (Supabase, migración logistica_webhook_entrega_pg_net) — pídele el valor real a Claude, no lo hardcodees.
LOGISTICA_WEBHOOK_SECRET=

# Módulo Terreno — Planificación semanal: cálculo de km real por red vial (nunca línea
# recta) para el fondo de viaje. Sin esto, las rutas quedan en estado
# "pendiente_de_calculo" — el resto del módulo funciona igual, solo no autoriza km
# automático (ver lib/terreno/rutas/proveedores/mapboxDirections.ts).
#
# Cómo conseguirlo (gratis, ~100.000 llamadas/mes en el free tier):
#   1. Crear cuenta en https://account.mapbox.com/auth/signup/
#   2. https://account.mapbox.com/access-tokens/ → "Create a token"
#   3. Alcance necesario: el scope público por defecto (styles:read + fonts:read +
#      datasets:read) ya incluye Directions API — no hace falta marcar nada extra.
#   4. Pegar el token acá para desarrollo local, y en Vercel → Project Settings →
#      Environment Variables (Production + Preview) para que funcione en producción.
MAPBOX_ACCESS_TOKEN=
